# Base URL of the deployed/local Express API (no trailing slash, no /api suffix)
VITE_API_URL=http://localhost:5000

# Production origin for canonical links, Open Graph URLs, sitemap and robots.txt
# (no trailing slash). Defaults to https://medisiem.vercel.app when unset.
VITE_SITE_URL=

# Plausible Analytics: the site's domain as registered in Plausible, e.g.
# medisiem.lk. Leave empty to ship with no analytics at all.
VITE_PLAUSIBLE_DOMAIN=
