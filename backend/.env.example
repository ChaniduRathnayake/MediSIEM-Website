# MongoDB Atlas connection string, e.g.
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/caap?retryWrites=true&w=majority
MONGO_URI=

# Port the Express server listens on
PORT=5000

# URL of the deployed/local client, used to configure CORS
CLIENT_URL=http://localhost:5173

# SMTP settings for the contact form (optional).
# If any of these are missing, contact messages are saved to the DB only
# and no email is sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_RECEIVER_EMAIL=

# Number of reverse proxies in front of the app (Render: 1). Used so the
# contact rate limit sees real visitor IPs. Set 0 when running without a proxy.
TRUST_PROXY=1
