# MongoDB Atlas connection string, e.g.
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/caap?retryWrites=true&w=majority
MONGO_URI=

# Port the Express server listens on
PORT=5000

# Allowed browser origins for CORS, comma-separated: the marketing frontend
# and the CDAP research site (cdap-site/). 127.0.0.1:5500 is VS Code Live Server.
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5500,http://localhost:5500

# SMTP settings for the contact form (optional).
# If any of these are missing, contact messages are saved to the DB only
# and no email is sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_RECEIVER_EMAIL=

# Number of reverse proxies in front of the app (Render: 1). Used so the
# contact rate limit sees real visitor IPs. Set 0 when running without a proxy.
TRUST_PROXY=1

# Secret for the admin API (/api/admin: edit CDAP site content, read contact
# messages). At least 24 characters; leave blank to keep the admin API off.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=
